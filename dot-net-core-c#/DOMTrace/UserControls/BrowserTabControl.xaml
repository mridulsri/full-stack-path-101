<UserControl x:Class="DOMTrace.UserControls.BrowserTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:cefSharp="clr-namespace:CefSharp.Wpf;assembly=CefSharp.Wpf"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:usercontrol="clr-namespace:DOMTrace.UserControls"
             xmlns:local="clr-namespace:DOMTrace.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Navigation Bar -->
        <DockPanel Margin="5" Grid.Row="0">

            <!-- Right-docked DevTools button -->
            <Button x:Name="DevToolsButton"
            Content="⚙"
            Click="DevTools_Click"
            Width="50"
            Margin="2"
            DockPanel.Dock="Right"/>

            <!-- Right-docked Go button -->
            <Button Content="Go"
            Width="50"
            Click="Go_Click"
            Margin="2,0"
            DockPanel.Dock="Right"/>

            <!-- Left-docked navigation buttons and favicon -->
            <Button x:Name="BackButton"
            Content="◀"
            Click="Back_Click"
            Margin="2"
            DockPanel.Dock="Left"/>

            <Button x:Name="ForwardButton"
            Content="▶"
            Click="Forward_Click"
            Margin="2"
            DockPanel.Dock="Left"/>

            <Image x:Name="Favicon"
           Width="16"
           Height="16"
           Margin="2,0"
           DockPanel.Dock="Left"/>

            <!-- TextBox fills remaining width -->
            <TextBox Name="AddressBar"
             Margin="2,0"
             VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Progress Bar -->
        <ProgressBar x:Name="LoadingProgressBar"
                     Grid.Row="0"
                     Height="4"
                     Margin="0,30,0,0"
                     Foreground="Green"
                     Visibility="Collapsed"
                     IsIndeterminate="True"/>

        <!-- Browser -->
        <cefSharp:ChromiumWebBrowser x:Name="Browser" Grid.Row="1" Address="https://www.bing.com"/>

        <!-- Expert Configuration Control -->
        <usercontrol:ExpertConfigControl Grid.Row="2" Margin="5" Width="Auto"/>
        <!-- XPath Display -->
        <!--<TextBox Name="XPathOutput" Grid.Row="2" Height="30" Margin="5" IsReadOnly="True"/>-->
    </Grid>
</UserControl>
