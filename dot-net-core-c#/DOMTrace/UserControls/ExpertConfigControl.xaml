<UserControl x:Class="DOMTrace.UserControls.ExpertConfigControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:DOMTrace.UserControls"
             xmlns:utils="clr-namespace:DOMTrace.Utils"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <utils:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
    </UserControl.Resources>
 
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <!-- Expert Configuration Form -->
            <StackPanel>
                <!-- Expert Type -->
                <StackPanel Orientation="Horizontal" Margin="5">
                    <!--<Label Content="Expert Type:" VerticalAlignment="Center" Margin="0,0,10,0"/>-->
                    <RadioButton 
                        Content="Expert Container" 
                        Name="RadioButtonExpertTypeContainer" 
                        Margin="10" 
                        GroupName="ExpertType"
                        IsChecked="{Binding SelectedExpertType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Container}"
                        Style="{StaticResource MaterialDesignRadioButton}" 
                        />
                    
                    <RadioButton 
                        Content="Expert Field" 
                        Name="RadioButtonExpertTypeField" 
                        Margin="10" 
                        GroupName="ExpertType" 
                        IsChecked="{Binding SelectedExpertType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Field}"
                        Style="{StaticResource MaterialDesignRadioButton}" />
                    
                </StackPanel>

                <!-- Expert Name -->
                <ComboBox Name="ComboBoxExpertName" Margin="5" 
                          Style="{StaticResource MaterialDesignComboBox}" 
                          materialDesign:HintAssist.Hint="Select Expert key" 
                          ItemsSource="{Binding ExpertNames}"
                          SelectedItem="{Binding SelectedExpertName, Mode=TwoWay}" />

                <!-- Expert Xpath/Selector -->
                <ComboBox Name="ComboBoxSelector" Margin="5" 
                    Style="{StaticResource MaterialDesignComboBox}" 
                    materialDesign:HintAssist.Hint="Select selector">
                    <ComboBoxItem Content="Type 1"/>
                    <ComboBoxItem Content="Type 2"/>
                    <ComboBoxItem Content="Type 3"/>
                </ComboBox>

                <!-- Expert Xpath/Selector -->
                <ComboBox Name="ComboBoxRegex" Margin="5" 
                    Style="{StaticResource MaterialDesignComboBox}" 
                    materialDesign:HintAssist.Hint="Select Regex"
                    ItemsSource="{Binding Regex}"
                    SelectedItem="{Binding SelectedRegex, Mode=TwoWay}"/>
                
                <!-- Expert Configuration List -->
                <TextBox Name="TextBoxDefaultValue" materialDesign:HintAssist.Hint="Default value" Style="{StaticResource {x:Type TextBox}}"/>
            </StackPanel>
            

            <!-- Expert Configuration List -->
            <StackPanel></StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
